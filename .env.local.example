# Kanonische URL der Website (ohne abschließenden Slash).
# Lokal optional, in Produktion setzen – wird für Metadata, Sitemap und robots.txt genutzt.
NEXT_PUBLIC_SITE_URL=https://www.ristorante-da-romolo.com

# Resend (https://resend.com) – Versand der Reservierungsanfragen per E-Mail.
# Ohne Key bleibt die Website funktionsfähig; das Formular zeigt dann den Hinweis,
# dass telefonisch reserviert werden soll.
RESEND_API_KEY=

# Absenderadresse. Die Domain muss in Resend verifiziert sein.
# Zum Testen funktioniert onboarding@resend.dev ohne eigene Domain.
RESEND_FROM_EMAIL="Ristorante da Romolo <onboarding@resend.dev>"

# Empfängeradresse der Reservierungsanfragen.
RESERVATION_TO_EMAIL=info@ristorante-da-romolo.de
